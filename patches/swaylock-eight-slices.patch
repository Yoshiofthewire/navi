--- a/include/navi-indicator.h
+++ b/include/navi-indicator.h
@@ -0,0 +1,24 @@
+/* Navi indicator only. Password storage and authentication remain upstream. */
+#ifndef NAVI_INDICATOR_H
+#define NAVI_INDICATOR_H
+#include <stddef.h>
+#include <stdint.h>
+
+static size_t navi_character_count(const char *buffer, size_t bytes) {
+    size_t count = 0;
+    for (size_t i = 0; i < bytes; ++i) {
+        if (((unsigned char)buffer[i] & 0xc0) != 0x80) { ++count; }
+    }
+    return count;
+}
+
+static uint32_t navi_slice_color(size_t characters, size_t slice) {
+    static const uint32_t colors[] = {
+        0x2ba3d8ff, 0x5bd6a2ff, 0xb69cffff,
+        0xf0c674ff, 0xf08cb7ff, 0x6bd9e7ff,
+    };
+    size_t lap = characters / 8;
+    size_t filled = characters % 8;
+    return colors[(lap + (slice < filled ? 1 : 0)) % (sizeof(colors) / sizeof(colors[0]))];
+}
+#endif
